{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-slidestudio.local/editor-oracle/interaction-row.schema.json",
  "title": "EditorOracleInteractionRow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "surface",
    "title",
    "preconditions",
    "action",
    "evidence",
    "test",
    "oracle",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)+$",
      "description": "Stable dotted id, e.g. chrome.export.open-dialog or text.toolbar.bold.toggle"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump when semantics of this row change"
    },
    "status": {
      "type": "string",
      "enum": [
        "discovered",
        "capturing",
        "specified",
        "implemented",
        "verified",
        "blocked",
        "wont-port"
      ],
      "description": "discovered=seen in iframe; specified=dual evidence complete; implemented=native wired; verified=self-test pass"
    },
    "surface": {
      "type": "string",
      "enum": [
        "chrome.global",
        "chrome.pages",
        "chrome.export",
        "selection",
        "insert",
        "element.text",
        "element.shape",
        "element.line",
        "element.image",
        "element.icon",
        "element.table",
        "element.chart",
        "element.smartart",
        "theme.background",
        "notes",
        "animation",
        "keyboard",
        "context-menu",
        "other"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kimiUi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlLabel": { "type": "string", "description": "Visible label / aria / tooltip as seen" },
        "location": { "type": "string", "description": "e.g. top toolbar / right panel / export modal" },
        "appearsWhen": { "type": "string" }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "selection"],
      "properties": {
        "fixtureId": {
          "type": "string",
          "description": "Key under fixtures/manifest.json"
        },
        "pageIndex": { "type": "integer", "minimum": 0 },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["none", "page", "element", "multi"]
            },
            "elementType": {
              "type": "string",
              "enum": [
                "text",
                "shape",
                "line",
                "image",
                "icon",
                "table",
                "chart",
                "unknown"
              ]
            },
            "elementHint": {
              "type": "string",
              "description": "Human or stable id hint inside fixture page"
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "steps"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "click",
            "toggle",
            "type-text",
            "drag",
            "select-menu",
            "keyboard",
            "dialog",
            "compound"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "input": {
          "type": "object",
          "description": "Structured input when action types text or picks a value",
          "additionalProperties": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenshots"],
      "properties": {
        "screenshots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "type": "string", "description": "Relative path under row dir" },
            "after": { "type": "string" },
            "focus": {
              "type": "string",
              "description": "Optional crop/callout of the control itself"
            }
          }
        },
        "pptd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "beforeDir": { "type": "string" },
            "afterDir": { "type": "string" },
            "unifiedDiff": { "type": "string" },
            "summary": { "type": "string" }
          }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pptxBefore": { "type": "string" },
            "pptxAfter": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "network": {
          "type": "string",
          "description": "Optional note if control only hits remote assets"
        }
      }
    },
    "expectedNative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mustChangeDocument": { "type": "boolean" },
        "commandHint": {
          "type": "string",
          "description": "Future native command name, e.g. updateElement"
        },
        "uiParityNotes": {
          "type": "string",
          "description": "How the control should look during Kimi-aligned phase"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EO-[A-Z0-9]+-[0-9]{3,}$",
          "description": "e.g. EO-TEXT-001"
        },
        "automated": {
          "type": "boolean",
          "description": "true when offline CI can run without iframe"
        },
        "selfTestChecklist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["kimi-iframe", "open-kimi-export", "manual", "derived"]
        },
        "capturedAt": { "type": "string", "format": "date-time" },
        "openKimiSkillVersion": { "type": "string" },
        "agent": { "type": "string" },
        "sessionId": { "type": "string" }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "blockedReason": { "type": "string" }
  }
}
