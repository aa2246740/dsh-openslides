pageType: content
background:
  type: image
  src: media/bg_exterior.jpg
  fit:
    mode: cover
elements:
  - elementId: overlay
    elementType: shape
    bounds:
      - 0
      - 0
      - 960
      - 540
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - position: 0
          color: "#000000F0"
        - position: 0.6
          color: "#0000008C"
        - position: 1
          color: "#00000000"
