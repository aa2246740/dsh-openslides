pageType: content
background:
  type: solid
  color: "#F8FAFC"
animations:
  - elementId: sh-round
    effect: fade-in
    trigger: onClick
    durationMs: 400
  - elementId: sh-arrow
    effect: fly-in
    trigger: afterPrevious
    durationMs: 500
    delayMs: 200
elements:
  - elementId: title
    elementType: text
    bounds:
      - 24
      - 12
      - 900
      - 28
    content:
      text: OOXML对照 presets · rect / roundRect / ellipse / triangle / rightArrow /
        callout
      style: $title
  - elementId: sh-rect
    elementType: shape
    shapeName: rect
    bounds:
      - 36
      - 56
      - 140
      - 88
    fill:
      type: solid
      color: "#2563EB"
  - elementId: sh-round
    elementType: shape
    shapeName: roundRect
    adjustments:
      - 16667
    bounds:
      - 200
      - 56
      - 140
      - 88
    fill:
      type: solid
      color: "#0EA5E9"
  - elementId: sh-ellipse
