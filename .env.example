# DSH SlideStudio — native DSH path
#
# Product start: `npm start` → DSH `slides` profile Hub on http://127.0.0.1:13080
# plus the native editor sidecar on http://127.0.0.1:55200 (scripts/dsh-slides.mjs).
# The sidecar (apps/native-web/src/server.mjs) loads a repo-root `.env`; the DSH
# kernel reads real environment variables plus provider keys imported into the
# isolated home (DSH_HOME/credentials/*.key, `~/.dsh/settings.yaml` import —
# Antigravity is skipped). Copy this file to `.env` for the sidecar, or export
# the vars in the shell so both processes see them.
#
# Never put real keys in this file or commit a real `.env`.

# ── Ports / paths ────────────────────────────────────────────────────────────
# SLIDES_DSH_PORT=13080        # DSH kernel + Hub. 3080 is rejected — it belongs to DSH.app.
# SLIDES_EDITOR_PORT=55200     # Editor sidecar port used by `npm start`.
# PORT=55200                   # Same sidecar port when running server.mjs standalone.
# DSH_HOME=<repo>/.dsh/home    # Isolated DSH home. Never point it at ~/.dsh —
                              # that would share OAuth grants with DSH.app.
# OPEN_SLIDESTUDIO_ROOT=<repo> # Repo root seen by the kernel plugin; startup sets it.
# OPEN_SLIDESTUDIO_PROJECT=fixtures/okp-yu7-ppt  # Default project when opening the editor directly.
# SLIDESTUDIO_EDITOR_URL=http://127.0.0.1:55200  # Editor origin the kernel uses for page rasters/screenshots.

# ── Provider credentials (kernel generate route) ─────────────────────────────
# Normal path: log in from the Hub (BYOK key or provider OAuth); keys land in
# DSH_HOME/credentials/<provider>.key. These env vars are the shell alternative.
# Default provider is minimax-cn (api.minimaxi.com, model MiniMax-M3); first
# nonempty alias wins and is bound to all three:
# MINIMAX_CN_API_KEY=
# MINIMAXCN_API_KEY=
# MINIMAX_API_KEY=
# OpenRouter fallback (minimax/minimax-m3:free) when China keys are absent/401/403:
# OPENROUTER_API_KEY=
# OPENROUTER_ONLYUSE_FREEMODEL_API_KEY=
# Other API-key providers imported into the isolated home:
# AMD_API_KEY=
# OP_CUSTOM_API_KEY=
# MIMO_DESKTOP_API_KEY is written by startup's MiMo desktop engine sync — do not set by hand.

# ── Generate route override (usually leave unset) ────────────────────────────
# Explicit route instead of the catalog default:
# SLIDESTUDIO_LLM_PROVIDER=minimax-cn
# SLIDESTUDIO_LLM_MODEL=MiniMax-M3

# ── Sidecar LLM (multimodal page review / image rebuild) ─────────────────────
# 不填也能用：正常生成走上面的供应商登录；没有登录时产品停在登录提示，不会假生成。
# 想用内网 / 本地 OpenAI 兼容模型做看图与重建：
#   1) 启动后在 Hub 配置，Key 只存在这台浏览器的 localStorage / 独立 home
#   2) 下面这些环境变量（服务端重建 / 看页会读）
# SLIDESTUDIO_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SLIDESTUDIO_LLM_API_KEY=
# 免费档多模态看页：gemini-3.5-flash（推荐）或 gemini-3.5-flash-lite。
# 聊天地址能看图，不等于能生图。Imagen / *-flash-image 是付费档。
# SLIDESTUDIO_LLM_MODEL=gemini-3.5-flash
# SLIDESTUDIO_LLM_TIMEOUT_MS=120000
# 设为 0 时图片重建 / 看页不走多模态
# SLIDESTUDIO_LLM_IMAGE=0
# 注意：provider 为 minimax-cn 时 SLIDESTUDIO_LLM_BASE_URL 只允许
# api.minimaxi.com；该情形下 SLIDESTUDIO_LLM_API_KEY 也算 MiniMax 凭证。

# ── Optional tool endpoints ──────────────────────────────────────────────────
# 可选：搜图端口（POST { query } → { images: [{ url | b64_json }] }）。不填 = 无搜图。
# Gemini google_search grounding 是网页摘录+引用，不会把图片字节写进 media/。
# Custom Search JSON API 的图片检索不对新客户开放，2027-01-01 停。
# SLIDESTUDIO_IMAGE_SEARCH_URL=
# SLIDESTUDIO_IMAGE_SEARCH_KEY=
#
# 可选：生图端口。仅 LLM 聊天地址不算生图。要复用聊天地址需 SLIDESTUDIO_IMAGE=1
# SLIDESTUDIO_IMAGE_BASE_URL=
# SLIDESTUDIO_IMAGE_API_KEY=
# SLIDESTUDIO_IMAGE_MODEL=
# SLIDESTUDIO_IMAGE=1            # 0 = 关闭生图
#
# 可选：联网研究端口（POST 研究查询 → 摘要）
# SLIDESTUDIO_RESEARCH_URL=
# SLIDESTUDIO_RESEARCH_API_KEY=
# SLIDESTUDIO_RESEARCH_TIMEOUT_MS=20000

# ── Housekeeping ─────────────────────────────────────────────────────────────
# SLIDESTUDIO_RETENTION_DAYS=0          # 0 = never auto-delete; >0 sweeps stale output/ projects
# SLIDESTUDIO_RETENTION_INTERVAL_MS=21600000  # sweep cadence, default 6h

# ── Auto-managed / test-only (do not set by hand) ────────────────────────────
# SLIDESTUDIO_PLAYWRIGHT_RUNTIME  # pinned browser runtime path; plugin sets it when ready
# NODE_OPTIONS                    # startup appends a --import resolve probe
# NATIVE_WEB_PERSIST_BARRIER_DIR / NATIVE_WEB_RESTORE_BARRIER_DIR  # test fault-injection barriers
# SLIDESTUDIO_QA_OUTPUT_DIR / QA_PORT / QA_ALLOW_EXTERNAL_MODEL    # QA script plumbing

# ── Legacy — NOT the DSH product path ────────────────────────────────────────
# SLIDESTUDIO_PI_* (BIN / MODEL / PROVIDER / AUTH_PATH / ALLOW_ENV / TIMEOUT_MS)
# belong to the `@open-slidestudio/agent-harness` freeze fixtures (Pi RPC). The
# product kernel is DSH (docs/adr/0009); Hub generate does not read them.
# SLIDESTUDIO_PI_BIN=/home/ubuntu/.local/pi-agent/bin/pi
# SLIDESTUDIO_PI_MODEL=
# SLIDESTUDIO_PI_PROVIDER=
# SLIDESTUDIO_PI_AUTH_PATH=/path/to/auth.json
# SLIDESTUDIO_PI_ALLOW_ENV=1
# SLIDESTUDIO_LLM_RETRY_MAX / _INITIAL_MS / _MAX_MS — agent-harness retry port, same scope.
#
# 以下仅旧栈（npm run dev → :5173，已归档），验收请不要用：
# OPENSLIDESTUDIO_PROVIDER=mock
# OPENSLIDESTUDIO_ALLOW_MOCK_FALLBACK=1  # opt-in: resolveProvider mock fallback
# OPENSLIDESTUDIO_GROK_AUTH=1            # opt-in: read ~/.grok credentials (needs GROK_CLI_CHAT_PROXY_BASE_URL)
# VITE_ALLOW_MOCK_FALLBACK=1             # opt-in: apps/web mock deck on API failure
# OPENSLIDESTUDIO_CORS_ORIGINS=          # extra origins for legacy apps/server
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
