{
  "name": "dsh-openslides",
  "version": "0.2.0",
  "description": "Editable presentations for DeepSeek Harness, with optional Personal integration",
  "type": "module",
  "main": "lib/dsh-personal-slides.js",
  "types": "lib/types/dsh-personal-slides.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:client": "node scripts/test-settings.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/dsh-personal-slides.d.ts",
      "default": "./lib/dsh-personal-slides.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "cordis.yml",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@open-slidestudio/dsh-slides-host": "link:../packages/dsh-slides-host"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0-0",
    "dsh-personal": ">=0.2.5 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "dsh-personal": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-openslides.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-openslides#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-openslides/issues"
  }
}
